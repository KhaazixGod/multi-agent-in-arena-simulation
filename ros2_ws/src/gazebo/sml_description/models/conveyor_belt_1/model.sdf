<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="conveyor_belt">
    <!--
      InfiniteConveyor plugin — drives all slat joints and wraps them.
      Adjust belt_speed (m/s) to change conveyor speed.
    -->
    <plugin filename="InfiniteConveyorPlugin" name="conveyor::InfiniteConveyor">
      <belt_speed>-0.2</belt_speed>
      <end_x>4.32</end_x>
      <num_slats>80</num_slats>
      <slat_pitch>0.05</slat_pitch>
      <first_slat_x>0.31</first_slat_x>
      <slat_prefix>slat2</slat_prefix>
      <coordinate>y</coordinate>
      <cmd_vel_topic>/conveyor2/cmd_vel</cmd_vel_topic>
    </plugin>
      <model name="conveyor_frame_2">
    <self_collide>true</self_collide>
    <pose>0.5 0.29 0 0 0 1.5708</pose>
    <include merge="true">
